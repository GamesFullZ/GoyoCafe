<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Menú Digital QR — Goyo Real Coffee</title>
  <meta name="description" content="Menú digital de Goyo Real Coffee optimizado para consulta en mesa vía código QR. Café de especialidad, matcha auténtico y repostería en Hermosillo.">
  <link rel="stylesheet" href="css/styles.css">
</head>
<body class="menu-qr-page">

  <!-- ==========================================================================
       BARRA SUPERIOR MINIMALISTA
       Wireframe: Gemini_Generated_Image_denpewdenpewdenp.jfif
       ========================================================================== -->
  <header class="qr-top-bar" role="banner">
    <a href="index.html" class="qr-back-link" aria-label="Volver a la página principal">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>Volver al sitio</span>
    </a>

    <span style="font-family: var(--font-heading); font-weight: 800; font-size: 0.9375rem; color: var(--color-text-primary);">
      Goyo Real Coffee
    </span>

    <span class="qr-brand-badge">En barra y para llevar</span>
  </header>

  <!-- ==========================================================================
       ENCABEZADO DE LA CARTA
       ========================================================================== -->
  <div class="qr-header-block">
    <h1 class="qr-main-title">Menú de Nuestra Esquina</h1>
    <p class="qr-price-info">Consumo promedio informado: <strong>$100 – $200 MXN</strong> por persona</p>
    <p class="qr-welcome-text">
      Si tienes alguna duda o buscas una recomendación personalizada, consúltalo con confianza con nuestros baristas en barra.
    </p>
  </div>

  <!-- ==========================================================================
       PILLS DE CATEGORÍAS (STICKY SUB-NAV)
       ========================================================================== -->
  <nav class="qr-sticky-pills" aria-label="Categorías del Menú QR">
    <a href="#seccion-matcha" class="qr-pill active">Matcha & Tés</a>
    <a href="#seccion-cafe" class="qr-pill">Café de Especialidad</a>
    <a href="#seccion-temporada" class="qr-pill">Jarabes & Temporada</a>
    <a href="#seccion-postres" class="qr-pill">Postres & Alimentos</a>
  </nav>

  <!-- ==========================================================================
       LISTADO ESTRUCTURADO CONTINUO
       ========================================================================== -->
  <main class="qr-section-container">
    
    <!-- 1. Matcha & Tés -->
    <section id="seccion-matcha" class="qr-category-group">
      <h2 class="qr-category-title">Matcha & Tés</h2>

      <div class="qr-item-row">
        <div class="qr-item-header">
          <span class="qr-item-name">Matcha Latte (Frío / Caliente)</span>
          <span class="item-badge badge-favorite">Calificado 1000/10</span>
        </div>
        <p class="qr-item-desc">
          Matcha ceremonial auténtico batido al momento con leche texturizada. Disponible en versión fría sobre hielo o caliente con microespuma.
        </p>
      </div>

      <div class="qr-item-row">
        <div class="qr-item-header">
          <span class="qr-item-name">Foam Matcha Latte</span>
          <span class="item-badge badge-season">Especial</span>
        </div>
        <p class="qr-item-desc">
          Matcha intenso coronado con suave crema fría de foam artesanal preparada en casa.
        </p>
      </div>

      <div class="qr-item-row">
        <div class="qr-item-header">
          <span class="qr-item-name">Té Matcha Tradicional</span>
          <span class="item-badge badge-house">Ceremonial</span>
        </div>
        <p class="qr-item-desc">
          Batido al momento con agua a temperatura controlada. Sabor puro y vegetal sin añadidos.
        </p>
      </div>

      <div class="qr-item-row">
        <div class="qr-item-header">
          <span class="qr-item-name">Té con Leche</span>
          <span class="item-badge badge-house">Infusión</span>
        </div>
        <p class="qr-item-desc">
          Infusiones seleccionadas con base láctea suave y perfil aromático reconfortante.
        </p>
      </div>
    </section>

    <!-- 2. Café de Especialidad -->
    <section id="seccion-cafe" class="qr-category-group">
      <h2 class="qr-category-title">Café de Especialidad</h2>

      <div class="qr-item-row">
        <div class="qr-item-header">
          <span class="qr-item-name">Espresso Doble</span>
          <span class="item-badge badge-house">Clásico</span>
        </div>
        <p class="qr-item-desc">
          Extracción limpia, balanceada y con notas complejas de café de origen seleccionado.
        </p>
      </div>

      <div class="qr-item-row">
        <div class="qr-item-header">
          <span class="qr-item-name">Café Americano</span>
          <span class="item-badge badge-house">Clásico</span>
        </div>
        <p class="qr-item-desc">
          Base de espresso doble y agua caliente filtrada, conservando el perfil aromático de la molienda.
        </p>
      </div>

      <div class="qr-item-row">
        <div class="qr-item-header">
          <span class="qr-item-name">Cortado</span>
          <span class="item-badge badge-favorite">Favorito</span>
        </div>
        <p class="qr-item-desc">
          Proporción equilibrada a partes iguales de café de especialidad y leche vaporizada sedosa.
        </p>
      </div>

      <div class="qr-item-row">
        <div class="qr-item-header">
          <span class="qr-item-name">Latte de la Casa</span>
          <span class="item-badge badge-house">Especialidad</span>
        </div>
        <p class="qr-item-desc">
          Espresso suave y leche cremosa con opción de foam artesanal. Disponible caliente o iced.
        </p>
      </div>
    </section>

    <!-- 3. Jarabes Caseros & Sabores de Temporada -->
    <section id="seccion-temporada" class="qr-category-group">
      <h2 class="qr-category-title">Jarabes Caseros & Sabores de Temporada</h2>

      <div class="qr-item-row">
        <div class="qr-item-header">
          <span class="qr-item-name">Bebidas con Jarabe Artesanal de la Casa</span>
          <span class="item-badge badge-season">Receta Exclusiva</span>
        </div>
        <p class="qr-item-desc">
          Elaborados en nuestra propia cocina con especias, vainas y frutos naturales, sin jarabes comerciales ni saborizantes artificiales. Pregunta en barra por el especial del mes.
        </p>
      </div>
    </section>

    <!-- 4. Postres & Alimentos -->
    <section id="seccion-postres" class="qr-category-group">
      <h2 class="qr-category-title">Postres & Alimentos</h2>

      <div class="qr-item-row">
        <div class="qr-item-header">
          <span class="qr-item-name">Galletas Horneadas en Casa</span>
          <span class="item-badge badge-house">Horneado Diario</span>
        </div>
        <p class="qr-item-desc">
          Receta artesanal recién horneada en pequeños lotes para acompañar tus bebidas calientes o frías.
        </p>
      </div>

      <div class="qr-item-row">
        <div class="qr-item-header">
          <span class="qr-item-name">Repostería y Menú del Día</span>
          <span class="item-badge badge-season">Rotativo</span>
        </div>
        <p class="qr-item-desc">
          Opciones frescas de panadería y repostería que rotan durante la semana. Consulta disponibilidad directa con nuestro barista.
        </p>
      </div>
    </section>

    <!-- Pie del Menú con CTA de Consulta en Barra -->
    <div style="text-align: center; margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--color-border);">
      <a href="tel:6623557949" class="btn btn-secondary" style="width: 100%; max-width: 320px; margin-bottom: 12px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Llamar / Consulta Rápida a Barra</span>
      </a>

      <p style="font-size: 0.8125rem; color: var(--color-text-muted); margin-top: 10px;">
        Goyo Real Coffee • Av. Nayarit y Yáñez 102, Hermosillo, Sonora
      </p>
    </div>

  </main>

  <!-- Botón Flotante de WhatsApp para Consulta en Barra -->
  <a href="https://wa.me/526623557949?text=Hola,%20estoy%20en%20el%20local%20y%20quiero%20consultar%20sobre%20el%20men%C3%BA" target="_blank" rel="noopener noreferrer" class="floating-whatsapp-btn" aria-label="Consultar por WhatsApp">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.979-.276-.1-.476-.15-.676.15-.2.3-.777.98-.952 1.18-.176.2-.351.226-.652.076-.3-.15-1.267-.467-2.414-1.489-.893-.797-1.496-1.78-1.671-2.08-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.526.15-.176.2-.301.301-.501.101-.2.051-.376-.025-.526-.076-.15-.677-1.633-.928-2.238-.244-.589-.493-.509-.677-.518-.175-.01-.375-.01-.576-.01s-.526.076-.802.376c-.276.301-1.053 1.028-1.053 2.508 0 1.48 1.078 2.909 1.229 3.109.15.2 2.122 3.24 5.14 4.542.718.31 1.278.496 1.716.635.722.23 1.378.198 1.9.12.58-.088 1.78-.727 2.03-1.429.25-.702.25-1.303.175-1.429-.075-.126-.275-.201-.576-.351zM12.04 2C6.536 2 2.072 6.46 2.072 11.96c0 1.99.585 3.844 1.597 5.414L2 22l4.82-1.614c1.51.87 3.25 1.374 5.22 1.374 5.504 0 9.968-4.46 9.968-9.96C22.008 6.46 17.544 2 12.04 2z"/>
    </svg>
    <span class="whatsapp-label">Barista en Barra</span>
  </a>

  <!-- Script para actualizar pills activas al hacer scroll en menu.html -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const pills = document.querySelectorAll('.qr-pill');
      const sections = document.querySelectorAll('.qr-category-group');

      window.addEventListener('scroll', () => {
        let current = '';
        sections.forEach(sec => {
          const secTop = sec.offsetTop - 140;
          if (window.pageYOffset >= secTop) {
            current = sec.getAttribute('id');
          }
        });

        pills.forEach(pill => {
          pill.classList.remove('active');
          if (pill.getAttribute('href') === '#' + current) {
            pill.classList.add('active');
          }
        });
      });
    });
  </script>
</body>
</html>
